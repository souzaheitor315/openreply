# Copy to .env ON THE SERVER and replace placeholders.
# Never commit .env, send these secrets in chat, or put them in GitHub source.
# Generate values with openssl on the server. Use simple hex for the DB password.
SITE_DOMAIN=seu-subdominio.duckdns.org
NEXTAUTH_URL=https://seu-subdominio.duckdns.org
ALLOWED_EMAILS=seu-email@example.com
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
CRON_SECRET=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# DATABASE_URL's password MUST match POSTGRES_PASSWORD (no special chars).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
DATABASE_URL=postgresql://openreply:replace-with-openssl-rand-hex-24@postgres:5432/openreply
REDIS_URL=redis://redis:6379

# Email login. Choose either SMTP (EMAIL_SERVER) or Resend (RESEND_API_KEY).
# For SMTP, URL-encode special chars in the username/password.
# EMAIL_SERVER=smtps://usuario%40gmail.com:senha-de-app@smtp.gmail.com:465
# RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <seu-email@example.com>

# Direct Instagram connection with your own Meta application.
# Keep tokens private. Fill these only after creating the Meta app.
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
